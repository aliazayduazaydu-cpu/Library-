function UIHybrid:MakeWindow(cfg)
	cfg = cfg or {}
	local T = Themes[cfg.Theme or "Darker"] or Themes.Darker

	local self = setmetatable({}, UIHybrid)
	self.Theme = T
	self.Tabs = {}
	self.Flags = {}
	self.Registry = {}
	self.ConfigFile = cfg.ConfigFile or "UIHybrid_Config.json"

	local gui = create("ScreenGui", {
		Name = "UIHybrid",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local okCore = pcall(function()
		gui.Parent = CoreGui
	end)
	if not okCore or not gui.Parent then
		gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	end
	self.Gui = gui

	-- Main box (430 x 260)
	local box = create("Frame", {
		Name = "Box",
		Size = UDim2.fromOffset(WIDTH, HEIGHT),
		Position = UDim2.new(0.5, -WIDTH / 2, 0.5, -HEIGHT / 2),
		BackgroundColor3 = T.Bg,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, gui)
	corner(box, UDim.new(0, 6))
	stroke(box, T.Stroke)

	-- Title bar
	local top = create("Frame", {
		Size = UDim2.new(1, 0, 0, TITLE_H),
		BackgroundTransparency = 1,
	}, box)
	makeDraggable(top, box)

	create("TextLabel", {
		Size = UDim2.new(1, -90, 1, 0),
		Position = UDim2.new(0, 12, 0, 0),
		BackgroundTransparency = 1,
		RichText = true,
		Text = string.format('%s  <font color="#8C8C8C">| %s</font>', cfg.Name or "UIHybrid", cfg.SubTitle or "Library"),
		TextColor3 = T.Text,
		TextSize = 15,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, top)

	local function headerBtn(text, offsetX)
		local b = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, offsetX, 0.5, 0),
			Size = UDim2.fromOffset(26, 26),
			BackgroundColor3 = T.Element,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = text,
			TextColor3 = T.Dim,
			TextSize = 16,
			Font = Enum.Font.GothamBold,
		}, top)
		corner(b, UDim.new(0, 4))
		return b
	end
	local closeBtn = headerBtn("X", -8)
	local minBtn = headerBtn("-", -40)

	create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.new(0, 0, 0, TITLE_H),
		BackgroundColor3 = T.Stroke,
		BorderSizePixel = 0,
	}, box)

	-- Content
	local content = create("Frame", {
		Name = "Content",
		Size = UDim2.new(1, 0, 1, -(TITLE_H + 1)),
		Position = UDim2.new(0, 0, 0, TITLE_H + 1),
		BackgroundTransparency = 1,
	}, box)

	-- Icon sidebar
	local sidebar = create("ScrollingFrame", {
		Size = UDim2.new(0, SIDEBAR_W, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, content)
	create("UIListLayout", {
		Padding = UDim.new(0, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, sidebar)
	create("UIPadding", { PaddingTop = UDim.new(0, 4) }, sidebar)

	create("Frame", {
		Size = UDim2.new(0, 1, 1, 0),
		Position = UDim2.new(0, SIDEBAR_W, 0, 0),
		BackgroundColor3 = T.Stroke,
		BorderSizePixel = 0,
	}, content)

	local area = create("Frame", {
		Size = UDim2.new(1, -(SIDEBAR_W + 1), 1, 0),
		Position = UDim2.new(0, SIDEBAR_W + 1, 0, 0),
		BackgroundTransparency = 1,
	}, content)

	self.Box = box
	self.TabList = sidebar
	self.Area = area

	-- Minimize / close
	local minimized = false
	minBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		content.Visible = not minimized
		minBtn.Text = minimized and "+" or "-"
		TweenService:Create(box, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(WIDTH, minimized and TITLE_H or HEIGHT),
		}):Play()
	end)

	-- RightControl toggles the whole UI
	local toggleConn = UIS.InputBegan:Connect(function(input, gp)
		if not gp and input.KeyCode == Enum.KeyCode.RightControl and gui.Parent then
			gui.Enabled = not gui.Enabled
		end
	end)

	closeBtn.MouseButton1Click:Connect(function()
		toggleConn:Disconnect()
		gui:Destroy()
	end)

	return self
end
	-- ================= زر فتح / غلق قابل للتحريك =================
	if cfg.OpenButton ~= false then
		local btnGui = create("ScreenGui", {
			Name = "UIHybrid_OpenButton",
			ResetOnSpawn = false,
		}, gui.Parent)

		local openBtn = create("TextButton", {
			Name = "OpenCloseButton",
			Size = UDim2.fromOffset(40, 40),
			Position = UDim2.new(0, 20, 0.5, -20),
			BackgroundColor3 = T.Element,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "UI",
			TextColor3 = T.Text,
			TextSize = 13,
			Font = Enum.Font.GothamBold,
		}, btnGui)
		corner(openBtn, UDim.new(0, 8))
		stroke(openBtn, T.Stroke)

		local function refreshOpenBtn()
			openBtn.TextColor3 = gui.Enabled and T.Accent or T.Text
		end

		-- السحب والضغط
		local dragging, moved = false, false
		local dragStart, startPos

		local conns = {}

		table.insert(conns, openBtn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				moved = false
				dragStart = input.Position
				startPos = openBtn.Position
			end
		end))

		table.insert(conns, UIS.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local d = input.Position - dragStart
				if d.Magnitude > 4 then
					moved = true
				end
				openBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end))

		table.insert(conns, UIS.InputEnded:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				dragging = false
				if not moved then
					gui.Enabled = not gui.Enabled
				end
			end
		end))

		gui:GetPropertyChangedSignal("Enabled"):Connect(refreshOpenBtn)
		gui.Destroying:Connect(function()
			for _, c in ipairs(conns) do
				c:Disconnect()
			end
			btnGui:Destroy()
		end)
		refreshOpenBtn()
	end

-- ================= Tabs =================
function UIHybrid:SelectTab(idx)
	local T = self.Theme
	for i, t in ipairs(self.Tabs) do
		local on = i == idx
		t.Page.Visible = on
		t.Button.BackgroundColor3 = on and T.Selected or T.Element
		t.Button.ImageColor3 = on and T.Text or T.Dim
	end
end

function UIHybrid:MakeTab(cfg)
	cfg = cfg or {}
	local T = self.Theme

	local icon = cfg.Icon or DEFAULT_ICON
	if type(icon) == "number" then
		icon = "rbxassetid://" .. icon
	elseif type(icon) == "string" and not icon:find("rbxassetid://") and not icon:find("rbxthumb://") then
		icon = "rbxassetid://" .. icon
	end

	local idx = #self.Tabs + 1

	local btn = create("ImageButton", {
		Size = UDim2.fromOffset(34, 34),
		BackgroundColor3 = T.Element,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Image = icon,
		ImageColor3 = T.Dim,
		LayoutOrder = idx,
	}, self.TabList)
	corner(btn, UDim.new(0, 6))

	local page = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
	}, self.Area)
	create("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, page)
	create("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
	}, page)

	local tab = setmetatable({ Window = self, Page = page, Button = btn }, Tab)
	table.insert(self.Tabs, tab)

	btn.MouseButton1Click:Connect(function()
		self:SelectTab(idx)
	end)
	if idx == 1 then
		self:SelectTab(1)
	end
	return tab
end

