function Tab:AddToggle(cfg)
	cfg = cfg or {}
	local W = self.Window
	local T = W.Theme
	local state = cfg.Default == true

	local btn = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = T.Element,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "  " .. (cfg.Name or "Toggle"),
		TextColor3 = T.Text,
		TextSize = 13,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.Page)
	corner(btn)

	local dot = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = T.Off,
		BorderSizePixel = 0,
	}, btn)
	corner(dot, UDim.new(1, 0))

	local function set(v, silent)
		state = v == true
		TweenService:Create(dot, TweenInfo.new(0.15), {
			BackgroundColor3 = state and T.Accent or T.Off,
		}):Play()
		if cfg.Flag then
			W.Flags[cfg.Flag] = state
		end
		if not silent then
			fire(cfg.Callback, state)
		end
	end

	btn.MouseButton1Click:Connect(function()
		set(not state)
	end)

	if cfg.Flag then
		W.Registry[cfg.Flag] = set
	end
	set(state, true)

	return {
		Set = function(_, v, silent)
			set(v, silent)
		end,
	}
end

function Tab:AddSlider(cfg)
	cfg = cfg or {}
	local W = self.Window
	local T = W.Theme
	local min, max = cfg.Min or 0, cfg.Max or 100
	local inc = cfg.Increment or 1
	local value = min

	local holder = create("Frame", {
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = T.Element,
		BorderSizePixel = 0,
	}, self.Page)
	corner(holder)

	create("TextLabel", {
		Size = UDim2.new(1, -70, 0, 20),
		Position = UDim2.new(0, 10, 0, 4),
		BackgroundTransparency = 1,
		Text = cfg.Name or "Slider",
		TextColor3 = T.Text,
		TextSize = 13,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, holder)

	local valueLbl = create("TextLabel", {
		Size = UDim2.new(0, 60, 0, 20),
		Position = UDim2.new(1, -70, 0, 4),
		BackgroundTransparency = 1,
		TextColor3 = T.Dim,
		TextSize = 12,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
	}, holder)

	local bar = create("Frame", {
		Size = UDim2.new(1, -20, 0, 6),
		Position = UDim2.new(0, 10, 0, 28),
		BackgroundColor3 = T.Off,
		BorderSizePixel = 0,
	}, holder)
	corner(bar, UDim.new(1, 0))

	local fill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = T.Accent,
		BorderSizePixel = 0,
	}, bar)
	corner(fill, UDim.new(1, 0))

	-- Larger invisible hit area so the slider is easy to grab
	local hit = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 0, 22),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, holder)

	local function set(v, silent)
		v = math.clamp(v, min, max)
		v = math.floor(v / inc + 0.5) * inc
		v = tonumber(string.format("%.2f", v))
		value = v
		fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
		valueLbl.Text = tostring(v)
		if cfg.Flag then
			W.Flags[cfg.Flag] = v
		end
		if not silent then
			fire(cfg.Callback, v)
		end
	end

	local dragging = false
	local function fromInput(input)
		local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		set(min + (max - min) * rel)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromInput(input)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromInput(input)
		end
	end)

	if cfg.Flag then
		W.Registry[cfg.Flag] = set
	end
	set(cfg.Default or min, true)

	return {
		Set = function(_, v, silent)
			set(v, silent)
		end,
	}
end

function Tab:AddDropdown(cfg)
	cfg = cfg or {}
	local W = self.Window
	local T = W.Theme
	local options = cfg.Options or {}
	local ROW, OPT = 30, 24
	local current
	local open = false

	local holder = create("Frame", {
		Size = UDim2.new(1, 0, 0, ROW),
		BackgroundColor3 = T.Element,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, self.Page)
	corner(holder)

	local head = create("TextButton", {
		Size = UDim2.new(1, 0, 0, ROW),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, holder)

	create("TextLabel", {
		Size = UDim2.new(0.5, 0, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = cfg.Name or "Dropdown",
		TextColor3 = T.Text,
		TextSize = 13,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, head)

	local valueLbl = create("TextLabel", {
		Size = UDim2.new(0.5, -28, 1, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = T.Dim,
		TextSize = 12,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, head)

	local list = create("Frame", {
		Position = UDim2.new(0, 0, 0, ROW),
		Size = UDim2.new(1, 0, 0, #options * (OPT + 2)),
		BackgroundTransparency = 1,
	}, holder)
	create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)

	local function setOpen(v)
		open = v
		holder.Size = UDim2.new(1, 0, 0, open and (ROW + #options * (OPT + 2)) or ROW)
	end

	local function set(v, silent)
		current = v
		valueLbl.Text = tostring(v or "")
		if cfg.Flag then
			W.Flags[cfg.Flag] = v
		end
		if not silent then
			fire(cfg.Callback, v)
		end
	end

	for _, opt in ipairs(options) do
		local ob = create("TextButton", {
			Size = UDim2.new(1, 0, 0, OPT),
			BackgroundColor3 = T.Bg,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "  " .. tostring(opt),
			TextColor3 = T.Dim,
			TextSize = 12,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, list)
		corner(ob, UDim.new(0, 4))
		ob.MouseButton1Click:Connect(function()
			set(opt)
			setOpen(false)
		end)
	end

	head.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	if cfg.Flag then
		W.Registry[cfg.Flag] = set
	end
	set(cfg.Default or options[1], true)

	return {
		Set = function(_, v, silent)
			set(v, silent)
		end,
	}
end

function Tab:AddTextBox(cfg)
	cfg = cfg or {}
	local W = self.Window
	local T = W.Theme

	local holder = create("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = T.Element,
		BorderSizePixel = 0,
	}, self.Page)
	corner(holder)

	create("TextLabel", {
		Size = UDim2.new(0.5, 0, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = cfg.Name or "TextBox",
		TextColor3 = T.Text,
		TextSize = 13,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, holder)

	local input = create("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0.45, 0, 0, 22),
		BackgroundColor3 = T.Bg,
		BorderSizePixel = 0,
		Text = "",
		PlaceholderText = cfg.Placeholder or "",
		PlaceholderColor3 = T.Dim,
		TextColor3 = T.Text,
		TextSize = 12,
		Font = Enum.Font.Gotham,
		ClearTextOnFocus = false,
	}, holder)
	corner(input, UDim.new(0, 4))

	local function set(v, silent)
		input.Text = tostring(v or "")
		if cfg.Flag then
			W.Flags[cfg.Flag] = input.Text
		end
		if not silent then
			fire(cfg.Callback, input.Text)
		end
	end

	input.FocusLost:Connect(function()
		set(input.Text)
	end)

	if cfg.Flag then
		W.Registry[cfg.Flag] = set
	end
	set(cfg.Default or "", true)

	return {
		Set = function(_, v, silent)
			set(v, silent)
		end,
	}
end

-- ================= Config =================
function UIHybrid:SaveConfig()
	if not writefile then
		warn("[UIHybrid] writefile غير متوفرة في هذا الـ executor")
		return false
	end
	local ok = pcall(writefile, self.ConfigFile, HttpService:JSONEncode(self.Flags))
	return ok
end

function UIHybrid:LoadConfig()
	if not (readfile and isfile) then
		return false
	end
	local exists = pcall(isfile, self.ConfigFile) and isfile(self.ConfigFile)
	if not exists then
		return false
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(self.ConfigFile))
	end)
	if not ok or type(data) ~= "table" then
		return false
	end
	for flag, val in pairs(data) do
		local apply = self.Registry[flag]
		if apply then
			apply(val, true)
		end
	end
	return true
end

return UIHybrid
