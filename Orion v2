				state = value
				AlfaLib.Flags[flag] = value
				local color = value and AlfaLib.Theme.White or AlfaLib.Theme.Black
				Tween(box, {BackgroundColor3 = color}, 0.2)
				task.spawn(ToggleConfig.Callback, value)
