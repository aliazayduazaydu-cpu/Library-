-- ============================================================
--  Init / Destroy
-- ============================================================

function AlfaLib:Init()
	AlfaLib.Alive = true
	ColorCycle()
	return true
end

function AlfaLib:Destroy()
	AlfaLib.Alive = false
	for _, conn in pairs(AlfaLib.Connections) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	if AlfaLib.Gui then
		AlfaLib.Gui:Destroy()
	end
	if AlfaLib.NotifyHost then
		AlfaLib.NotifyHost:Destroy()
	end
end

