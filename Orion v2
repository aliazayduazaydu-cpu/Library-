		--  Slider
		-- ----------------------------------------------------

		function Tab:AddSlider(SliderConfig)
			SliderConfig = SliderConfig or {}
			SliderConfig.Callback = SliderConfig.Callback or function() end

			local min = SliderConfig.Min or 0
			local max = SliderConfig.Max or 100
			local value = SliderConfig.Default or min
			local flag = SliderConfig.Flag or SliderConfig.Name or "slider"

			local frame = Row(50)
			Caption(frame, SliderConfig.Name or "Slider", UDim2.fromOffset(10, 4), UDim2.new(1, -20, 0, 20))

			local valueLabel = Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(0, 4),
				Size = UDim2.new(1, -12, 0, 20),
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 = AlfaLib.Theme.White,
				TextXAlignment = Enum.TextXAlignment.Right,
				Text = tostring(value),
				ZIndex = 5,
				Parent = frame,
			})

			local bar = Create("Frame", {
				Size = UDim2.new(1, -20, 0, 6),
				Position = UDim2.new(0, 10, 1, -16),
				BackgroundColor3 = AlfaLib.Theme.Black,
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = frame,
			})
			Create("UICorner", {CornerRadius = UDim.new(0, 3), Parent = bar})

			local fill = Create("Frame", {
				Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
				BackgroundColor3 = AlfaLib.Theme.White,
				BorderSizePixel = 0,
				ZIndex = 6,
				Parent = bar,
			})
			Create("UICorner", {CornerRadius = UDim.new(0, 3), Parent = fill})

			local hit = Create("TextButton", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				Text = "",
				ZIndex = 7,
				Parent = frame,
			})

			local dragging = false
			local Slider = {}

			local function Set(newValue)
				value = math.clamp(Round(newValue, SliderConfig.Increment or 1), min, max)
				local rel = (value - min) / (max - min)
				Tween(fill, {Size = UDim2.new(rel, 0, 1, 0)}, 0.08)
				valueLabel.Text = tostring(value)
				AlfaLib.Flags[flag] = value
				task.spawn(SliderConfig.Callback, value)
			end

			local function FromX(x)
				local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
				Set(min + (max - min) * rel)
			end

			AddConnection(hit.InputBegan, function(input)
				local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
				local isTouch = input.UserInputType == Enum.UserInputType.Touch
				if isMouse or isTouch then
					dragging = true
					FromX(input.Position.X)
				end
			end)

			AddConnection(UserInputService.InputEnded, function(input)
				local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
				local isTouch = input.UserInputType == Enum.UserInputType.Touch
				if isMouse or isTouch then
					dragging = false
				end
			end)

			AddConnection(UserInputService.InputChanged, function(input)
				local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
				local isTouch = input.UserInputType == Enum.UserInputType.Touch
				if dragging and (isMouse or isTouch) then
					FromX(input.Position.X)
				end
			end)

			AlfaLib.Setters[flag] = Set

			function Slider:Set(Value)
				Set(Value)
			end
			return Slider
		end

		-- ----------------------------------------------------
		--  Dropdown
		-- ----------------------------------------------------

		function Tab:AddDropdown(DropdownConfig)
			DropdownConfig = DropdownConfig or {}
			DropdownConfig.Callback = DropdownConfig.Callback or function() end

			local options = DropdownConfig.Options or {}
			local current = DropdownConfig.Default or options[1] or "None"
			local flag = DropdownConfig.Flag or DropdownConfig.Name or "dropdown"
			local opened = false

			local frame = Row(36)
			frame.ClipsDescendants = true

			local head = Create("TextButton", {
				Size = UDim2.new(1, 0, 0, 36),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamSemibold,
				TextSize = 14,
				TextColor3 = AlfaLib.Theme.White,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 5,
				Parent = frame,
			})
			Create("UIPadding", {PaddingLeft = UDim.new(0, 10), Parent = head})

			local list = Create("Frame", {
				Position = UDim2.fromOffset(0, 40),
				Size = UDim2.new(1, 0, 0, 0),
				BackgroundTransparency = 1,
				ZIndex = 5,
				Parent = frame,
			})
			Create("UIListLayout", {
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
				Parent = list,
			})

			local Dropdown = {}

			local function Update()
				head.Text = (DropdownConfig.Name or "Dropdown") .. ":  " .. tostring(current)
			end

			local function Relayout()
				local extra = 0
				if opened then
					extra = #options * 30
				end
				Tween(frame, {Size = UDim2.new(1, -8, 0, 40 + extra)}, 0.2)
			end

			local function AddOptions(opts)
				for _, option in ipairs(opts) do
					local optionBtn = Create("TextButton", {
						Size = UDim2.new(1, -10, 0, 26),
						BackgroundColor3 = AlfaLib.Theme.Black,
						Text = tostring(option),
						Font = Enum.Font.Gotham,
						TextSize = 13,
						TextColor3 = AlfaLib.Theme.White,
						ZIndex = 6,
						Parent = list,
					})
					Create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = optionBtn})

					AddConnection(optionBtn.MouseButton1Click, function()
						current = option
						AlfaLib.Flags[flag] = option
						Update()
						opened = false
						Relayout()
						task.spawn(DropdownConfig.Callback, option)
					end)
				end
			end

			AddOptions(options)
			Update()

			AddConnection(head.MouseButton1Click, function()
				opened = not opened
				Relayout()
			end)

			function Dropdown:Refresh(NewOptions, Delete)
				if Delete then
					for _, child in ipairs(list:GetChildren()) do
						if child:IsA("TextButton") then
							child:Destroy()
						end
					end
				end
				options = NewOptions or {}
				AddOptions(options)
			end

			function Dropdown:Set(Value)
				current = Value
				AlfaLib.Flags[flag] = Value
				Update()
				task.spawn(DropdownConfig.Callback, Value)
			end

			AlfaLib.Setters[flag] = function(value)
				Dropdown:Set(value)
			end

			return Dropdown
		end

		-- ----------------------------------------------------
		--  Bind (keybind)
		-- ----------------------------------------------------

		function Tab:AddBind(BindConfig)
			BindConfig = BindConfig or {}
			BindConfig.Callback = BindConfig.Callback or function() end

			local key = BindConfig.Default or Enum.KeyCode.E
			local flag = BindConfig.Flag or BindConfig.Name or "bind"
			local binding = false

			local frame = Row(36)
			Caption(frame, BindConfig.Name or "Bind", UDim2.fromOffset(10, 0), UDim2.new(1, -110, 1, 0))

			local keyBtn = Create("TextButton", {
				Size = UDim2.fromOffset(90, 24),
				Position = UDim2.new(1, -98, 0.5, -12),
				BackgroundColor3 = AlfaLib.Theme.Black,
				Text = key.Name,
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = AlfaLib.Theme.White,
				ZIndex = 5,
				Parent = frame,
			})
			Create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = keyBtn})

			local Bind = {}

			function Bind:Set(Value)
				key = Value
				keyBtn.Text = Value.Name
				AlfaLib.Flags[flag] = Value.Name
			end

			AlfaLib.Setters[flag] = function(name)
				local ok, keyCode = pcall(function()
					return Enum.KeyCode[name]
				end)
				if ok and keyCode then
					Bind:Set(keyCode)
				end
			end

			AddConnection(keyBtn.MouseButton1Click, function()
				binding = true
				keyBtn.Text = "..."
			end)

			AddConnection(UserInputService.InputBegan, function(input, processed)
				if binding and input.UserInputType == Enum.UserInputType.Keyboard then
					binding = false
					Bind:Set(input.KeyCode)
				elseif not processed and input.KeyCode == key then
					task.spawn(BindConfig.Callback)
				end
			end)

			AlfaLib.Flags[flag] = key.Name
			return Bind
		end

		-- ----------------------------------------------------
		--  Textbox
		-- ----------------------------------------------------

		function Tab:AddTextbox(TextboxConfig)
			TextboxConfig = TextboxConfig or {}
			TextboxConfig.Callback = TextboxConfig.Callback or function() end

			local flag = TextboxConfig.Flag or TextboxConfig.Name or "textbox"

			local frame = Row(36)
			Caption(frame, TextboxConfig.Name or "Textbox", UDim2.fromOffset(10, 0), UDim2.new(0.45, 0, 1, 0))

			local box = Create("TextBox", {
				Size = UDim2.new(0.5, 0, 0, 24),
				Position = UDim2.new(0.48, 0, 0.5, -12),
				BackgroundColor3 = AlfaLib.Theme.Black,
				Text = TextboxConfig.Default or "",
				PlaceholderText = TextboxConfig.Placeholder or "...",
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextColor3 = AlfaLib.Theme.White,
				ClearTextOnFocus = false,
				ZIndex = 5,
				Parent = frame,
			})
			Create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = box})

			AddConnection(box:GetPropertyChangedSignal("Text"), function()
				AlfaLib.Flags[flag] = box.Text
			end)

			AddConnection(box.FocusLost, function(enterPressed)
				TextboxConfig.Callback(box.Text, enterPressed)
			end)

			AlfaLib.Setters[flag] = function(value)
				box.Text = tostring(value)
			end

			local Textbox = {}
			function Textbox:Set(Value)
				box.Text = Value
			end
			return Textbox
		end

		-- ----------------------------------------------------
		--  Colorpicker
		-- ----------------------------------------------------

		function Tab:AddColorpicker(ColorpickerConfig)
			ColorpickerConfig = ColorpickerConfig or {}
			ColorpickerConfig.Callback = ColorpickerConfig.Callback or function() end

			local color = ColorpickerConfig.Default or AlfaLib.Theme.White
			local flag = ColorpickerConfig.Flag or ColorpickerConfig.Name or "color"
			local h, s, v = Color3.toHSV(color)
			local expanded = false

			local frame = Row(36)
			frame.ClipsDescendants = true
			Caption(frame, ColorpickerConfig.Name or "Color", UDim2.fromOffset(10, 0), UDim2.new(1, -60, 0, 36))

			local preview = Create("Frame", {
				Size = UDim2.fromOffset(40, 22),
				Position = UDim2.new(1, -48, 0, 7),
				BackgroundColor3 = color,
				ZIndex = 5,
				Parent = frame,
			})
			Create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = preview})
			StrokeOn(preview, 1)

			local openBtn = Create("TextButton", {
				Size = UDim2.new(1, 0, 0, 36),
				BackgroundTransparency = 1,
				Text = "",
				ZIndex = 6,
				Parent = frame,
			})

			local panel = Create("Frame", {
				Position = UDim2.fromOffset(8, 40),
				Size = UDim2.new(1, -16, 0, 90),
				BackgroundTransparency = 1,
				ZIndex = 5,
				Parent = frame,
			})

			local hueBar = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundColor3 = AlfaLib.Theme.White,
				ZIndex = 5,
				Parent = panel,
			})
			Create("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
					ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
					ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
					ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
					ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
				}),
				Parent = hueBar,
			})

			local valBar = Create("Frame", {
				Position = UDim2.fromOffset(0, 24),
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundColor3 = AlfaLib.Theme.White,
				ZIndex = 5,
				Parent = panel,
			})
			Create("UIGradient", {
				Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.new(1, 1, 1)),
				Parent = valBar,
			})

			local hueKnob = Create("Frame", {
				Size = UDim2.fromOffset(4, 18),
				BackgroundColor3 = AlfaLib.Theme.White,
				ZIndex = 6,
				Parent = hueBar,
			})
			local valKnob = Create("Frame", {
				Size = UDim2.fromOffset(4, 18),
				BackgroundColor3 = AlfaLib.Theme.White,
				ZIndex = 6,
				Parent = valBar,
			})

			local Colorpicker = {}

			local function Update()
				color = Color3.fromHSV(h, 1, v)
				preview.BackgroundColor3 = color
				valBar.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				hueKnob.Position = UDim2.new(h, -2, -2, 0)
				valKnob.Position = UDim2.new(v, -2, -2, 0)
				AlfaLib.Flags[flag] = {
					R = Round(color.R * 255),
					G = Round(color.G * 255),
					B = Round(color.B * 255),
				}
				task.spawn(ColorpickerConfig.Callback, color)
			end

			local function Track(bar, setter)
				local dragging = false
				AddConnection(bar.InputBegan, function(input)
					local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
					local isTouch = input.UserInputType == Enum.UserInputType.Touch
					if isMouse or isTouch then
						dragging = true
						setter(math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1))
					end
				end)
				AddConnection(UserInputService.InputEnded, function(input)
					local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
					local isTouch = input.UserInputType == Enum.UserInputType.Touch
					if isMouse or isTouch then
						dragging = false
					end
				end)
				AddConnection(UserInputService.InputChanged, function(input)
					local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
					local isTouch = input.UserInputType == Enum.UserInputType.Touch
					if dragging and (isMouse or isTouch) then
						setter(math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1))
					end
				end)
			end

			Track(hueBar, function(x)
				h = x
				Update()
			end)
			Track(valBar, function(x)
				v = x
				Update()
			end)

			AddConnection(openBtn.MouseButton1Click, function()
				expanded = not expanded
				local height = 36
				if expanded then
					height = 140
				end
				Tween(frame, {Size = UDim2.new(1, -8, 0, height)}, 0.2)
			end)

			function Colorpicker:Set(Value)
				h, s, v = Color3.toHSV(Value)
				Update()
			end

			AlfaLib.Setters[flag] = function(tbl)
				if type(tbl) == "table" then
					Colorpicker:Set(Color3.fromRGB(tbl.R, tbl.G, tbl.B))
				end
			end

			Update()
			return Colorpicker
		end

		return Tab
	end

	return Window
end

AlfaLib.Icons = IconTable

