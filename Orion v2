-- ============================================================
--  Helpers
-- ============================================================

local function IsRunning()
	return AlfaLib.Alive
end

local function AddConnection(Signal, Function)
	if not IsRunning() then
		return nil
	end
	local conn = Signal:Connect(Function)
	table.insert(AlfaLib.Connections, conn)
	return conn
end

local function Create(Name, Properties, Children)
	local obj = Instance.new(Name)
	for key, value in pairs(Properties or {}) do
		obj[key] = value
	end
	for _, child in pairs(Children or {}) do
		child.Parent = obj
	end
	return obj
end

local function Round(Number, Factor)
	Factor = Factor or 1
	return math.floor(Number / Factor + 0.5) * Factor
end

local function Tween(obj, props, duration)
	local info = TweenInfo.new(duration or 0.25, Enum.EasingStyle.Quad)
	TweenService:Create(obj, info, props):Play()
end

local function AddDraggingFunctionality(DragPoint, Main)
	local dragging = false
	local dragStart = nil
	local startPos = nil

	DragPoint.InputBegan:Connect(function(input)
		local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
		local isTouch = input.UserInputType == Enum.UserInputType.Touch
		if isMouse or isTouch then
			dragging = true
			dragStart = input.Position
			startPos = Main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
		local isTouch = input.UserInputType == Enum.UserInputType.Touch
		if dragging and (isMouse or isTouch) then
			local delta = input.Position - dragStart
			Main.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function StrokeOn(parent, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.Color = AlfaLib.Theme.White
	stroke.Thickness = thickness or 1.2
	stroke.Parent = parent
	table.insert(AlfaLib.StrokeList, stroke)
	return stroke
end

local function ColorCycle()
	task.spawn(function()
		while IsRunning() do
			local alpha = (math.sin(tick() * 1.6) + 1) / 2
			local color = AlfaLib.Theme.White:Lerp(AlfaLib.Theme.Black, alpha)
			for i = #AlfaLib.StrokeList, 1, -1 do
				local stroke = AlfaLib.StrokeList[i]
				if stroke and stroke.Parent then
					stroke.Color = color
				else
					table.remove(AlfaLib.StrokeList, i)
				end
			end
			task.wait(0.03)
		end
	end)
end

-- ============================================================
--  Config
-- ============================================================

local function LoadCfg(Config)
	local ok, data = pcall(function()
		return HttpService:JSONDecode(Config)
	end)
	if not ok or type(data) ~= "table" then
		return
	end
	for flag, value in pairs(data) do
		local setter = AlfaLib.Setters[flag]
		if setter then
			task.spawn(setter, value)
		end
	end
end

local function SaveCfg(Name)
	if not writefile then
		return
	end
	pcall(function()
		if makefolder and not isfolder(AlfaLib.Folder) then
			makefolder(AlfaLib.Folder)
		end
		writefile(AlfaLib.Folder .. "/" .. Name .. ".json", HttpService:JSONEncode(AlfaLib.Flags))
	end)
end

